# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# Obtenlo en: https://developers.facebook.com → Tu App → WhatsApp → API Setup
WHATSAPP_TOKEN=tu_token_de_meta_aqui
WHATSAPP_PHONE_ID=tu_phone_number_id

# Token que tú inventas para verificar el webhook con Meta
VERIFY_TOKEN=un_token_secreto_que_tu_eliges

# ─── Resend (para envío de correos) ──────────────────────────────────────────
# Obtener en: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Correo donde llegarán las notificaciones del bot
DESTINATION_EMAIL=tu_correo@empresa.com

# ─── Google Sheets (catálogo de productos) ────────────────────────────────────
# URL de publicación del CSV: Archivo → Publicar en la web → CSV
GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/TU_ID/pub?output=csv

# ─── Claude AI (conversación libre) ──────────────────────────────────────────
# Obtener en: console.anthropic.com → API Keys
# Si no se configura, el bot ignora preguntas libres y sigue el flujo normal
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000

# URL pública del bot (Railway la asigna automáticamente via RAILWAY_PUBLIC_DOMAIN)
# Solo configurar si no usas Railway o quieres sobreescribir la URL automática
# BASE_URL=https://tu-dominio.railway.app

# Ruta del archivo de log de cotizaciones (opcional, por defecto: ./cotizaciones.json)
# LOG_PATH=./cotizaciones.json
